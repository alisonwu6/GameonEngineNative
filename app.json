{
  "expo": {
    "name": "GameOn",
    "slug": "GameonEngineNative",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F8EF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.GameonEngineNative",
      "infoPlist": {
        "NSCameraUsageDescription": "GameOn needs your camera to take venue logo photos.",
        "NSPhotoLibraryUsageDescription": "GameOn needs photo library access to upload venue logos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F8EF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.GameonEngineNative",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4A7A4A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GameOn needs photo library access to upload venue logos.",
          "cameraPermission": "GameOn needs your camera to take venue logo photos."
        }
      ]
    ]
  }
}
